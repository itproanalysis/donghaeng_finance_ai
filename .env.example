# Local workspace development defaults.
# Copy this file to .env.local. Do not reuse these identity settings in production.
# If host/port differ from the defaults, export DONGHAENG_HOST/DONGHAENG_PORT
# in the process environment before starting the current custom server.
DONGHAENG_HOST=127.0.0.1
DONGHAENG_PORT=3000
DONGHAENG_APP_ORIGIN=http://127.0.0.1:3000
DONGHAENG_DB_PATH=data/donghaeng-ai.db
DONGHAENG_LOCAL_BOOTSTRAP=1
# Optional password for direct local login. Leave blank to use browser bootstrap
# only; the server never falls back to a shared default password.
# DONGHAENG_LOCAL_PASSWORD=

# Reserved exclusively for scripts/e2e-smoke.mjs. Local password/session auth
# is fail-closed in production unless this is exactly 1, host/port/origin are
# matching literal loopback values, AND the custom server attests its actual
# loopback bind. The flag alone never enables direct Next routes. Never enable
# this in a deployment or copy it into .env.local.
# DONGHAENG_E2E_AUTH_ALLOW_LOCAL=0

# Interview text orchestration. Keep the default deterministic adapter for
# repeatable local tests. Real Claude mode reads ANTHROPIC_API_KEY only on the
# server; never expose it through NEXT_PUBLIC_* or commit it to this file.
DONGHAENG_ORCHESTRATOR_PROVIDER=deterministic
# ANTHROPIC_API_KEY=
# DONGHAENG_ANTHROPIC_MODEL=claude-sonnet-5
# DONGHAENG_ANTHROPIC_TIMEOUT_MS=20000
# DONGHAENG_ANTHROPIC_MAX_TOKENS=4096
# DONGHAENG_ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages

# Development never fabricates a transcript from microphone audio. Without a
# configured provider it stays in text mode. The supplied local faster-whisper
# bridge is OpenAI-compatible and binds to 127.0.0.1 only:
#   .\scripts\setup-local-korean-stt.ps1 -DownloadModel
#   .\scripts\start-local-korean-stt.ps1
DONGHAENG_STT_PROVIDER=disabled
# DONGHAENG_STT_ENDPOINT=http://127.0.0.1:8765/v1/audio/transcriptions
# DONGHAENG_STT_API_KEY=local-voice-runtime
# DONGHAENG_STT_MODEL=large-v3-turbo
# DONGHAENG_STT_TIMEOUT_MS=30000
# DONGHAENG_STT_MAX_BUFFER_BYTES=4194304
# DONGHAENG_STT_MAX_CHUNKS=2048

# AI 질문 음성은 로컬 loopback Qwen3-TTS 1.7B CustomVoice를 기본으로
# 사용합니다. 이 값은 서버에만 존재하며 브라우저에 노출되지 않습니다.
# DONGHAENG_TTS_ENDPOINT=http://127.0.0.1:8766/v1/audio/speech
# DONGHAENG_TTS_API_KEY=local-tts-runtime
# DONGHAENG_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# DONGHAENG_TTS_VOICE=Sohee
